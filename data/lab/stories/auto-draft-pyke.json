{
	"id": "auto-draft-pyke",
	"title": "Auto /draft fires at least once and at most three times on the pyke-picks replay",
	"split": "train",
	"steps": [
		{
			"idle": true
		},
		{
			"idle": true,
			"timeout": 45,
			"optional": true
		}
	],
	"replay": "data/lab/drafts/pyke-picks.json",
	"replayStepMs": 1500,
	"env": {
		"VOXREN_COACH_AUTO_COMP": "1"
	},
	"gates": {
		"runs": {
			"command": "draft",
			"min": 1,
			"max": 3
		},
		"maxSeconds": 240
	}
}
